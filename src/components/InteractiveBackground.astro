---
---

<div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
  <!-- Subtle architectural drafting grid & margin rules -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(120,116,108,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(120,116,108,0.06)_1px,transparent_1px)] bg-[size:40px_40px]"></div>

  <!-- Interactive Nanquim / Crosshatching Vector Field Canvas -->
  <canvas id="nanquim-bg-canvas" class="w-full h-full opacity-80 dark:opacity-75 transition-opacity duration-500"></canvas>
</div>

<script>
  function initNanquimCanvas() {
    const canvas = document.getElementById('nanquim-bg-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let animationFrameId: number;
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);
    let time = 0;

    const mouse = {
      x: -1000,
      y: -1000,
      targetX: -1000,
      targetY: -1000,
      radius: 210,
    };

    const handleResize = () => {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    };

    const handleMouseMove = (e: MouseEvent) => {
      mouse.targetX = e.clientX;
      mouse.targetY = e.clientY;
    };

    const handleMouseLeave = () => {
      mouse.targetX = -1000;
      mouse.targetY = -1000;
    };

    window.addEventListener('resize', handleResize);
    window.addEventListener('mousemove', handleMouseMove, { passive: true });
    window.addEventListener('mouseleave', handleMouseLeave);

    const render = () => {
      time += 0.006;
      mouse.x += (mouse.targetX - mouse.x) * 0.12;
      mouse.y += (mouse.targetY - mouse.y) * 0.12;

      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains('dark');
      const inkRGB = isDark ? '242, 239, 233' : '18, 18, 17';

      const step = 36;
      const cols = Math.ceil(width / step) + 1;
      const rows = Math.ceil(height / step) + 1;

      ctx.lineCap = 'round';

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const x = i * step;
          const y = j * step;

          // Smooth harmonic vector field (like magnetic/fluid field lines in a notebook)
          const baseAngle =
            Math.sin(x * 0.0035 + time) * Math.cos(y * 0.0035 - time * 0.7) * Math.PI * 0.85 +
            Math.PI * 0.25;

          const dx = x - mouse.x;
          const dy = y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          let angle = baseAngle;
          let strokeLen = 11;
          let alpha = isDark ? 0.11 : 0.13;
          let lineWidth = 0.85;

          if (dist < mouse.radius) {
            const influence = 1 - dist / mouse.radius;
            // Swirl / dipole deflection around cursor
            const cursorAngle = Math.atan2(dy, dx) + Math.PI / 2;
            angle = baseAngle * (1 - influence * 0.65) + cursorAngle * (influence * 0.65);
            strokeLen = 11 + influence * 9;
            alpha = (isDark ? 0.12 : 0.14) + influence * 0.38;
            lineWidth = 0.85 + influence * 0.75;

            // Secondary cross-hatching stroke (hachura cruzada) near the cursor!
            if (influence > 0.22) {
              const crossAngle = angle + Math.PI / 2.2;
              const cx = Math.cos(crossAngle) * (strokeLen * 0.45);
              const cy = Math.sin(crossAngle) * (strokeLen * 0.45);
              ctx.beginPath();
              ctx.strokeStyle = `rgba(${inkRGB}, ${(influence - 0.2) * 0.35})`;
              ctx.lineWidth = 0.75;
              ctx.moveTo(x - cx, y - cy);
              ctx.lineTo(x + cx, y + cy);
              ctx.stroke();
            }
          }

          const hx = Math.cos(angle) * (strokeLen * 0.5);
          const hy = Math.sin(angle) * (strokeLen * 0.5);

          ctx.beginPath();
          ctx.strokeStyle = `rgba(${inkRGB}, ${alpha})`;
          ctx.lineWidth = lineWidth;
          ctx.moveTo(x - hx, y - hy);
          ctx.lineTo(x + hx, y + hy);
          ctx.stroke();
        }
      }

      animationFrameId = requestAnimationFrame(render);
    };

    render();

    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(animationFrameId);
        window.removeEventListener('resize', handleResize);
        window.removeEventListener('mousemove', handleMouseMove);
        window.removeEventListener('mouseleave', handleMouseLeave);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initNanquimCanvas);
</script>
