---
import { ROUTES, type Lang, type PageKey } from '../i18n/routes';

interface Props {
  lang?: Lang;
  page: PageKey;
}

const { lang = 'pt', page } = Astro.props;
const isEn = lang === 'en';

const navLinks: Array<{ key: PageKey; href: string; num: string; label: string }> = [
  { key: 'home', href: ROUTES[lang].home, num: 'I.', label: isEn ? 'Home' : 'Início' },
  {
    key: 'publications',
    href: ROUTES[lang].publications,
    num: 'II.',
    label: isEn ? 'Publications' : 'Publicações',
  },
  {
    key: 'projects',
    href: ROUTES[lang].projects,
    num: 'III.',
    label: isEn ? 'Projects' : 'Projetos',
  },
  { key: 'about', href: ROUTES[lang].about, num: 'IV.', label: isEn ? 'CV & Bio' : 'Súmula & Bio' },
];
---

<header
  class="sticky top-0 z-50 bg-paper/95 dark:bg-ink-night/95 backdrop-blur-sm border-b-2 border-ink dark:border-ink-chalk transition-colors duration-300"
>
  <!-- Top fine hatching strip -->
  <div class="h-1.5 w-full hatch-diagonal border-b border-ink/30 dark:border-ink-chalk/30"></div>

  <nav class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
    <!-- Brand / Personal Monogram C²R (Caio Cavallari Ruas) in Nanquim Line-Art style -->
    <a
      href={ROUTES[lang].home}
      class="group flex items-center gap-2 sm:gap-3.5 min-w-0 text-ink dark:text-ink-chalk tracking-tight"
      title="C²R — Caio Marcelo Cavallari Ruas"
    >
      <div class="relative shrink-0 w-9 h-9 sm:w-11 sm:h-11 border-[1.5px] border-ink dark:border-ink-chalk bg-paper-light dark:bg-ink-nightCard flex items-center justify-center group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
        <div class="absolute inset-0 translate-x-1 translate-y-1 -z-10 hatch-dense border border-ink dark:border-ink-chalk"></div>
        <!-- Monogram C²R SVG in Clean Calligraphic / Italic Engraving Style -->
        <svg class="w-6 h-6 sm:w-8 sm:h-8" viewBox="0 0 64 64" fill="none" stroke="currentColor">
          <!-- Clean Calligraphic 'C' (no inner hatch ticks) -->
          <path
            d="M 38 15 C 20 10.5, 9.5 21, 9.5 33.5 C 9.5 45.5, 19.5 54, 37 49.5"
            stroke-width="3.8"
            stroke-linecap="round"
          />

          <!-- Italic Slanted 'R' fused with the 'C' -->
          <line x1="27" y1="17" x2="19.5" y2="49" stroke-width="3.4" stroke-linecap="round" />
          <line x1="23.5" y1="17" x2="30.5" y2="17" stroke-width="2.2" stroke-linecap="round" />
          <line x1="16" y1="49" x2="23.5" y2="49" stroke-width="2.2" stroke-linecap="round" />
          <path
            d="M 27 17.5 H 35.5 C 43 17.5, 41.5 31.5, 32 31.5 H 23.5"
            stroke-width="3.1"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M 30.5 31.5 C 34.5 36, 37.5 44, 41.5 48.5 C 43 50, 45 50, 47 48"
            stroke-width="3.3"
            stroke-linecap="round"
          />

          <!-- Superscript Exponent '2' (C²R) -->
          <path
            d="M 44.5 14 C 45 10.8, 51.8 10.8, 51.2 14.6 C 50.6 17.5, 43.5 20.2, 43 23.2 H 51"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="font-serif text-base sm:text-xl font-bold leading-none tracking-tight truncate">
          Caio M. C. Ruas
        </span>
        <span class="text-[9px] sm:text-[10px] font-mono uppercase tracking-wider sm:tracking-widest text-ink-muted dark:text-ink-chalk/70 mt-1 truncate">
          Ilum &bull; CNPEM<span class="hidden sm:inline"> &bull; {isEn ? 'Scientific Notebook' : 'Caderno Científico'}</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-1" id="desktop-nav">
      {
        navLinks.map((link) => {
          const active = link.key === page;
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'px-3.5 py-1.5 text-xs font-mono uppercase tracking-wider transition-all duration-150 border-[1.5px]',
                active
                  ? 'bg-ink text-paper dark:bg-ink-chalk dark:text-ink-night border-ink dark:border-ink-chalk font-bold shadow-[3px_3px_0px_rgba(18,18,17,0.28)] dark:shadow-[3px_3px_0px_rgba(242,239,233,0.28)]'
                  : 'border-transparent text-ink-muted dark:text-ink-chalk/80 hover:border-ink/40 dark:hover:border-ink-chalk/40 hover:text-ink dark:hover:text-ink-chalk',
              ]}
            >
              <span class="opacity-60 mr-1">{link.num}</span>
              <span>{link.label}</span>
            </a>
          );
        })
      }
    </div>

    <!-- Right Controls: BR/EN Flag Selector + Compact Theme Toggle + Mobile Menu -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Language Selector Tab (BR / ING with flags) -->
      <div
        class="inline-flex items-center border-[1.5px] border-ink dark:border-ink-chalk bg-paper-light dark:bg-ink-nightCard h-8 text-[10px] sm:text-[11px] font-mono"
        role="group"
        aria-label={isEn ? 'Select language' : 'Selecionar idioma'}
      >
        <a
          href={ROUTES.pt[page]}
          hreflang="pt-BR"
          aria-current={lang === 'pt' ? 'page' : undefined}
          title="Português (Brasil)"
          class:list={[
            'lang-tab-btn h-full px-1.5 sm:px-2 flex items-center gap-1 sm:gap-1.5 transition-colors',
            lang === 'pt'
              ? 'bg-ink text-paper dark:bg-ink-chalk dark:text-ink-night font-bold'
              : 'text-ink-muted dark:text-ink-chalk/75 hover:text-ink dark:hover:text-ink-chalk',
          ]}
        >
          <!-- Brazil Flag SVG -->
          <svg class="w-3.5 h-2.5 shrink-0 border border-black/20" viewBox="0 0 20 14" fill="none">
            <rect width="20" height="14" fill="#009B3A" />
            <polygon points="10,1.8 18.2,7 10,12.2 1.8,7" fill="#FEDF00" />
            <circle cx="10" cy="7" r="3" fill="#002776" />
            <path d="M7.2 6.4 Q10 5.4 12.8 7.3" stroke="#FFFFFF" stroke-width="0.6" fill="none" />
          </svg>
          <span>BR</span>
        </a>

        <span class="w-[1px] h-full bg-ink/40 dark:bg-ink-chalk/40"></span>

        <a
          href={ROUTES.en[page]}
          hreflang="en"
          aria-current={lang === 'en' ? 'page' : undefined}
          title="English"
          class:list={[
            'lang-tab-btn h-full px-1.5 sm:px-2 flex items-center gap-1 sm:gap-1.5 transition-colors',
            lang === 'en'
              ? 'bg-ink text-paper dark:bg-ink-chalk dark:text-ink-night font-bold'
              : 'text-ink-muted dark:text-ink-chalk/75 hover:text-ink dark:hover:text-ink-chalk',
          ]}
        >
          <!-- US/UK English Flag SVG -->
          <svg class="w-3.5 h-2.5 shrink-0 border border-black/20" viewBox="0 0 20 14" fill="none">
            <rect width="20" height="14" fill="#012169" />
            <path d="M0,0 L20,14 M20,0 L0,14" stroke="#FFFFFF" stroke-width="2.4" />
            <path d="M0,0 L20,14 M20,0 L0,14" stroke="#C8102E" stroke-width="1.2" />
            <path d="M10,0 V14 M0,7 H20" stroke="#FFFFFF" stroke-width="4" />
            <path d="M10,0 V14 M0,7 H20" stroke="#C8102E" stroke-width="2.4" />
          </svg>
          <span>ING</span>
        </a>
      </div>

      <!-- Smaller, delicate Sun/Moon Theme Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        aria-label={isEn ? 'Toggle light or dark theme' : 'Alternar tema claro ou escuro'}
        title={isEn ? 'Toggle light / dark theme' : 'Alternar tema claro / escuro'}
        class="ink-btn w-8 h-8 flex items-center justify-center"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="w-3.5 h-3.5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label={isEn ? 'Open navigation menu' : 'Abrir índice'}
        class="md:hidden ink-btn w-8 h-8 flex items-center justify-center"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t-[1.5px] border-ink dark:border-ink-chalk bg-paper dark:bg-ink-night px-4 py-3 space-y-1.5">
    {
      navLinks.map((link) => {
        const active = link.key === page;
        return (
          <a
            href={link.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'block px-4 py-2 text-xs font-mono uppercase tracking-wider border-[1.5px] transition-colors',
              active
                ? 'bg-ink text-paper dark:bg-ink-chalk dark:text-ink-night border-ink dark:border-ink-chalk font-bold'
                : 'border-transparent text-ink-muted dark:text-ink-chalk/80 hover:border-ink dark:hover:border-ink-chalk',
            ]}
          >
            <span class="opacity-60 mr-1.5">{link.num}</span>
            <span>{link.label}</span>
          </a>
        );
      })
    }
  </div>
</header>

<script>
  function setupNavbar() {
    const themeToggleBtn = document.getElementById('theme-toggle');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (themeToggleBtn && !themeToggleBtn.hasAttribute('data-bound')) {
      themeToggleBtn.setAttribute('data-bound', 'true');
      themeToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }

    if (mobileMenuBtn && mobileMenu && !mobileMenuBtn.hasAttribute('data-bound')) {
      mobileMenuBtn.setAttribute('data-bound', 'true');
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }

    if (mobileMenu) {
      mobileMenu.classList.add('hidden');
    }
  }

  document.addEventListener('astro:page-load', setupNavbar);
</script>
