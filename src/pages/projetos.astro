---
import BaseLayout from '../layouts/BaseLayout.astro';
import Katex from '../components/Katex.astro';
import { projects } from '../data/portfolioData';

const categories = [
  { id: 'todos', labelPt: 'Todos os Registros', labelEn: 'All Projects' },
  { id: 'hackathon', labelPt: 'Hackathons & Inovação', labelEn: 'Hackathons & Innovation' },
  { id: 'codigo', labelPt: 'Códigos & Pesquisa', labelEn: 'Code & Research' },
  { id: 'jogo', labelPt: 'Jogos & Simulações', labelEn: 'Games & Simulations' },
];
---

<BaseLayout
  title="Projetos, Hackathons & Jogos"
  description="Repositórios e projetos de Caio Ruas: Firefly Lens, Viu AI (1º Lugar Hack2L Unicamp), Não É Só Reta (1º Lugar PGMAT/UNESP), Caju (NASA Space Apps People's Choice), SEI Hub e Molecule Lab."
>
  <section class="space-y-8">
    <!-- Archival Header -->
    <div class="border-b-2 border-ink dark:border-ink-chalk pb-6 space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono uppercase tracking-widest text-ink-muted dark:text-ink-chalk/70">
        <span>
          <span class="lang-pt">PRANCHAS DE ENGENHARIA &bull; SECÇÃO III</span>
          <span class="lang-en">ENGINEERING PLATES &bull; SECTION III</span>
        </span>
        <span>
          <span class="lang-pt">CÓDIGOS, HACKATHONS &amp; JOGOS CIENTÍFICOS</span>
          <span class="lang-en">CODE, HACKATHONS &amp; SCIENTIFIC GAMES</span>
        </span>
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight">
        <span class="lang-pt">Projetos &amp; Repositórios</span>
        <span class="lang-en">Projects &amp; Repositories</span>
      </h1>
      <p class="text-ink-muted dark:text-ink-chalk/85 max-w-3xl text-base leading-relaxed lang-pt">
        Destaques de repositórios colaborativos, soluções desenvolvidas em hackathons (<strong class="text-ink dark:text-ink-chalk">Hack2L Unicamp</strong>, <strong class="text-ink dark:text-ink-chalk">NASA Space Apps Challenge</strong>, <strong class="text-ink dark:text-ink-chalk">NextWave</strong>, <strong class="text-ink dark:text-ink-chalk">AMAthon</strong>), modelagens matemáticas/físicas e projetos para divulgação científica.
      </p>
      <p class="text-ink-muted dark:text-ink-chalk/85 max-w-3xl text-base leading-relaxed lang-en">
        Featured collaborative repositories, hackathon solutions (<strong class="text-ink dark:text-ink-chalk">Hack2L Unicamp</strong>, <strong class="text-ink dark:text-ink-chalk">NASA Space Apps Challenge</strong>, <strong class="text-ink dark:text-ink-chalk">NextWave</strong>, <strong class="text-ink dark:text-ink-chalk">AMAthon</strong>), mathematical/physical modeling, and science outreach projects.
      </p>
    </div>

    <!-- Category Filter Bar -->
    <div class="flex flex-wrap items-center gap-2">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            data-project-filter={cat.id}
            class:list={[
              'px-4 py-2 text-xs font-mono uppercase tracking-wider border-[1.5px] transition-all duration-150',
              idx === 0
                ? 'bg-ink text-paper dark:bg-ink-chalk dark:text-ink-night border-ink dark:border-ink-chalk font-bold shadow-[3px_3px_0px_rgba(18,18,17,0.28)] dark:shadow-[3px_3px_0px_rgba(242,239,233,0.28)]'
                : 'bg-paper-light dark:bg-ink-nightCard border-ink dark:border-ink-chalk text-ink-muted dark:text-ink-chalk/80 hover:text-ink dark:hover:text-ink-chalk',
            ]}
          >
            <span class="lang-pt">{cat.labelPt}</span>
            <span class="lang-en">{cat.labelEn}</span>
          </button>
        ))
      }
    </div>

    <!-- Animated Engraving Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid">
      {
        projects.map((project, index) => (
          <article
            data-project-card
            data-project-category={project.category}
            style={`animation-delay: ${index * 70}ms`}
            class="project-card ink-card p-6 sm:p-7 flex flex-col justify-between"
          >
            <div>
              <!-- Top Plate Header -->
              <div class="flex items-center justify-between gap-2 pb-3 mb-4 border-b-[1.5px] border-ink dark:border-ink-chalk text-xs font-mono">
                <div class="flex items-center gap-2">
                  <span class="inline-block p-[3px] crosshatch-pattern border border-ink dark:border-ink-chalk">
                    <span class="block px-2 py-0.5 bg-paper-light dark:bg-ink-nightCard border border-ink/70 dark:border-ink-chalk/70 font-bold">
                      {project.figNumber}
                    </span>
                  </span>
                  <span class="uppercase tracking-wider">
                    <span class="lang-pt">{project.categoryLabel}</span>
                    <span class="lang-en">{project.categoryLabelEn}</span>
                  </span>
                </div>
                <span class="font-bold">{project.year}</span>
              </div>

              {project.highlight && (
                <div class="inline-block mb-3 px-2.5 py-0.5 text-[11px] font-mono uppercase tracking-wider bg-ink text-paper dark:bg-ink-chalk dark:text-ink-night font-bold">
                  ★ <span class="lang-pt">{project.highlight}</span><span class="lang-en">{project.highlightEn || project.highlight}</span>
                </div>
              )}

              {project.image && (
                <div class="mb-4 border-[1.5px] border-ink dark:border-ink-chalk bg-paper dark:bg-ink-night p-1.5 overflow-hidden">
                  <div class="relative aspect-video overflow-hidden border border-ink/40 dark:border-ink-chalk/40">
                    <img
                      src={project.image}
                      alt={`Screenshot do projeto ${project.title}`}
                      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                </div>
              )}

              <h2 class="font-serif text-2xl sm:text-3xl font-bold leading-snug">
                <span class="lang-pt">{project.title}</span>
                <span class="lang-en">{project.titleEn}</span>
              </h2>

              <p class="text-xs font-mono text-ink-muted dark:text-ink-chalk/75 mt-1">
                <span class="lang-pt">{project.subtitle}</span>
                <span class="lang-en">{project.subtitleEn}</span>
              </p>

              <p class="text-sm text-ink-muted dark:text-ink-chalk/85 mt-3.5 leading-relaxed">
                <span class="lang-pt">{project.description}</span>
                <span class="lang-en">{project.descriptionEn}</span>
              </p>

              {project.equation && (
                <div class="mt-4 px-3.5 py-2.5 border border-ink dark:border-ink-chalk bg-paper dark:bg-ink-night text-xs">
                  <Katex block={true} math={project.equation} />
                </div>
              )}
            </div>

            <div class="mt-6 pt-4 border-t border-ink/30 dark:border-ink-chalk/30 space-y-3">
              <div class="flex flex-wrap gap-1.5">
                {project.tech.map((techItem) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 border border-ink/50 dark:border-ink-chalk/50">
                    {techItem}
                  </span>
                ))}
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
                <span class="text-xs font-mono text-ink-faint truncate max-w-[180px]">
                  {project.repoName}
                </span>

                <div class="flex items-center gap-2">
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ink-btn px-3.5 py-1.5 text-xs font-mono font-bold uppercase tracking-wider inline-flex items-center gap-1"
                    >
                      <span>Site / Demo</span>
                      <span>&nearr;</span>
                    </a>
                  )}
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ink-btn-primary px-3.5 py-1.5 text-xs font-mono font-bold uppercase tracking-wider inline-flex items-center gap-1"
                  >
                    <span>GitHub</span>
                    <span>&nearr;</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes inkPlateAppear {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-card {
    animation: inkPlateAppear 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>

<script>
  function initProjectsPage() {
    const filterButtons = document.querySelectorAll('[data-project-filter]');
    const cards = document.querySelectorAll('[data-project-card]');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-project-filter') || 'todos';

        filterButtons.forEach((b) => {
          const isActive = b.getAttribute('data-project-filter') === selected;
          b.className = isActive
            ? 'px-4 py-2 text-xs font-mono uppercase tracking-wider border-[1.5px] transition-all duration-150 bg-ink text-paper dark:bg-ink-chalk dark:text-ink-night border-ink dark:border-ink-chalk font-bold shadow-[3px_3px_0px_rgba(18,18,17,0.28)] dark:shadow-[3px_3px_0px_rgba(242,239,233,0.28)]'
            : 'px-4 py-2 text-xs font-mono uppercase tracking-wider border-[1.5px] transition-all duration-150 bg-paper-light dark:bg-ink-nightCard border-ink dark:border-ink-chalk text-ink-muted dark:text-ink-chalk/80 hover:text-ink dark:hover:text-ink-chalk';
        });

        cards.forEach((card) => {
          const cat = card.getAttribute('data-project-category');
          const el = card as HTMLElement;
          if (selected === 'todos' || cat === selected) {
            el.style.display = '';
            el.style.animation = 'none';
            el.offsetHeight;
            el.style.animation = '';
          } else {
            el.style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initProjectsPage);
</script>
